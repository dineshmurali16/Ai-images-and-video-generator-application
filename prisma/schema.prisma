generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum GenerationMode {
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
}

enum CreditType {
  ALLOCATION
  RESERVATION
  REFUND
  USAGE
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  credits       Int               @default(40)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  videos        Video[]
  prompts       Prompt[]
  jobs          GenerationJob[]
  creditEntries UsageCredit[]
}

model Video {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  prompt          String
  negativePrompt  String?
  style           String
  aspectRatio     String
  duration        Int
  resolution      String
  mode            GenerationMode @default(TEXT_TO_VIDEO)
  status          VideoStatus    @default(QUEUED)
  provider        String         @default("runway")
  providerTaskId  String?
  outputUrl       String?
  thumbnailUrl    String?
  shareToken      String?        @unique
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?
  promptRecord    Prompt?
  job             GenerationJob?

  @@index([userId, createdAt])
  @@index([status])
}

model Prompt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId        String?  @unique
  video          Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  input          String
  enhanced       String?
  negativePrompt String?
  style          String
  aspectRatio    String
  duration       Int
  resolution     String
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model GenerationJob {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId        String      @unique
  video          Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  providerTaskId String?
  status         VideoStatus @default(QUEUED)
  attempts       Int         @default(0)
  lastError      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
}

model UsageCredit {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  type      CreditType
  reason    String
  videoId   String?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
}
