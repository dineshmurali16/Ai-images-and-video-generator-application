NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visionai?schema=public

# Use a long random value in production
JWT_SECRET=replace-with-a-long-random-secret

# Runway API (server-side only). See README for current model/ratio support.
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
RUNWAY_MODEL=hailuo3

# Optional prompt enhancement. The app returns a clear 503 when this is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Keep uploads outside the public directory.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
